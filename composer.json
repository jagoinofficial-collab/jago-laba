{
    "name": "jagolaba/jago-laba",
    "description": "Jago Laba Konveksi and Marketplace Marketing System",
    "type": "project",
    "license": "proprietary",
    "require": {"php": ">=8.2"},
    "autoload": {
        "classmap": ["app/Core/", "app/Shared/", "app/Modules/", "app/Bridges/"],
        "exclude-from-classmap": ["/app/**/Views/", "/app/**/Controllers/Api/", "/app/Shared/Auth/Api/", "/app/Shared/Support/Api/"]
    },
    "scripts": {
        "structure-check": "@php bin/console structure:check"
    },
    "config": {"sort-packages": true}
}
