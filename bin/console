#!/usr/bin/env php
<?php
declare(strict_types=1);
// Read-only operations deliberately do not boot the application or connect to MySQL.
$root = dirname(__DIR__);
$command = $argv[1] ?? 'help';
if ($command === 'structure:check') {
    $required = ['app/Bootstrap/bootstrap.php','app/Core/Database/Database.php',
        'app/Modules/Konveksi/Services','app/Modules/Marketplace/Services',
        'app/Modules/Konveksi/Views','app/Modules/Marketplace/Views',
        'config/storage.php','config/queue.php','config/integrations.php',
        'routes/web.php','routes/api.php','bin/workers','composer.json'];
    $missing = array_values(array_filter($required, static fn($path) => !file_exists($root . '/' . $path)));
    echo json_encode(['status' => $missing ? 'failed' : 'ok', 'missing' => $missing], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
    exit($missing ? 1 : 0);
}
echo "Jago Laba console\n  structure:check  Verify functional folders without database access\n";
exit($command === 'help' ? 0 : 1);
