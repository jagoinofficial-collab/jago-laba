APP_NAME="Jago Laba Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jago_laba
# DB_USERNAME=root
# DB_PASSWORD=
# Legacy aliases are used only when their DB_* counterpart is absent.
# JL_DB_HOST=127.0.0.1
# JL_DB_PORT=3306
# JL_DB_NAME=jago_laba
# JL_DB_USER=root
# JL_DB_PASS=
# JL_DB_CONNECTION=mysql
JL_COMPANY_KEY=LOCAL-COMPANY
JL_KONVEKSI_DATABASE_ISOLATED=false
JL_APP_BASE_URL=
# JL_LEGACY_SESSION_COOKIE=JAGO_LABA_LOCAL_SESSION
# JL_LEGACY_SESSION_PATH=

# Provider values are server-side only. Do not commit real credentials.
JL_MARKETPLACE_TOKEN_ENCRYPTION_KEY=
JL_MARKETPLACE_TOKEN_ENCRYPTION_KEY_FILE=
JL_MARKETPLACE_CATALOG_RECONCILE_SECONDS=86400
JL_MARKETPLACE_RETURNS_RECONCILE_SECONDS=86400
JL_MARKETPLACE_WEBHOOK_URL=
JL_MARKETPLACE_OAUTH_MODE=sandbox
JL_MARKETPLACE_OAUTH_STATE_TTL=600
JL_MARKETPLACE_OAUTH_RETRY_ATTEMPTS=2
JL_MARKETPLACE_SYNC_QUEUE=marketplace
JL_MARKETPLACE_SYNC_PAGE_SIZE=50
JL_MARKETPLACE_SYNC_PAGE_SIZE_MAX=100
JL_MARKETPLACE_SYNC_MAX_PAGES=20
JL_MARKETPLACE_SYNC_MAX_PAGES_MAX=100
JL_MARKETPLACE_SYNC_MAX_STORES=20
JL_MARKETPLACE_SYNC_MAX_STORES_MAX=100
JL_MARKETPLACE_SYNC_LEASE_SECONDS=45

JL_SHOPEE_PARTNER_ID=
JL_SHOPEE_PARTNER_KEY=
JL_SHOPEE_REGION=live
JL_SHOPEE_AUTH_URL=https://open.shopee.com/auth
JL_SHOPEE_API_BASE_URL=https://partner.shopeemobile.com

JL_TIKTOK_SHOP_APP_KEY=
JL_TIKTOK_SHOP_APP_SECRET=
JL_TIKTOK_SHOP_SERVICE_ID=
JL_TIKTOK_SHOP_MARKET=
JL_TIKTOK_SHOP_REGION=row
JL_TIKTOK_SHOP_REQUIRED_SCOPES=seller.authorization.info
JL_TIKTOK_SHOP_AUTH_URL=https://services.tiktokshop.com/open/authorize
JL_TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
